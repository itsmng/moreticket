#!/usr/bin/make -f

# Variables
NAME = moreticket
VERSION = CHANGEVERSION

%:
	dh $@

override_dh_auto_install:
	composer install --no-dev

	mkdir -p usr/share/itsm-ng/plugins/$(NAME)
	find . -mindepth 1 -maxdepth 1 \
		! -name usr \
		! -name debian \
		! -name .git \
		! -name .github \
		! -name .gitattributes \
		! -name .gitignore \
		! -name ISSUE_TEMPLATE.md \
		! -name .atoum.php \
		! -name tests \
                ! -name tools \
                ! -name README.md \
		! -name composer.json \
		-exec cp -a {} usr/share/itsm-ng/plugins/$(NAME)/ \;

override_dh_gencontrol:
	dh_gencontrol -- -v$(VERSION)
